{
  "name": "image-markup-kit",
  "version": "0.1.0",
  "description": "Photo markup and multi-photo boards for React: pen, highlighter, shapes, arrows, polylines, curves, text and notes, flattened to one JPEG or PNG. Reads and writes ImageMarkupKit document.json (schema 1).",
  "keywords": [
    "markup",
    "annotation",
    "annotate",
    "image",
    "photo",
    "drawing",
    "arrow",
    "board",
    "react",
    "svg",
    "canvas"
  ],
  "license": "MIT",
  "author": "thnhsng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thnhsng/image-markup-kit-web.git"
  },
  "homepage": "https://github.com/thnhsng/image-markup-kit-web#readme",
  "bugs": {
    "url": "https://github.com/thnhsng/image-markup-kit-web/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:pack": "node scripts/pack-check.mjs",
    "check:dts49": "node scripts/dts49.mjs",
    "check:compat": "node scripts/compat.mjs",
    "scan:privacy": "node scripts/privacy-scan.mjs --tree --history --pack",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:browser && npm run build && npm run check:pack && npm run check:dts49 && npm run scan:privacy",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepublishOnly": "npm run verify && node scripts/privacy-scan.mjs --pack --require-terms",
    "test:coverage": "vitest run --coverage --project core --project react",
    "test:browser": "vitest run --project browser"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
